{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ServiceBus": {
    "Namespace": "Endpoint=sb://localhost;SharedAccessKeyName=RootManageSharedAccessKey;SharedAccessKey=SAS_KEY_VALUE;UseDevelopmentEmulator=true;"
  },
  "MessageSubscriberSettings": {
    "ProcessorQueueOrTopicName": "api-inbox",
    "Senders": ["orders-topic", "notifications"]
  },
  "HealthCheckSettings": {
    "SenderName": "notifications"
  },
  "DestinationQueues": {
    "Queues": {
      "payments": "payments",
      "inventory": "inventory",
      "notifications": "notifications"
    }
  }
}
